    {
      "name": "02 - Ordering (HTTP + gRPC + ACL + Outbox)",
      "item": [
        {
          "name": "Check Availability (HTTP -> gRPC)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{orderingUrl}}/api/orders/availability",
            "description": "İstemci Ordering'e REST ile gelir; Ordering Inventory'ye gRPC ile sorar.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{keyboardId}}\",\n      \"quantity\": 2\n    },\n    {\n      \"productId\": \"{{monitorId}}\",\n      \"quantity\": 5\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Order - Happy Path",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": "{{orderingUrl}}/api/orders",
            "description": "ERP (ACL/HTTP) kredi kontrolü -> gRPC stok/fiyat -> EF Core kayıt -> Outbox (CAP). Sipariş önce Pending oluşur, StockReserved event'i ile Confirmed olur.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerCode\": \"{{customerCode}}\",\n  \"items\": [\n    {\n      \"productId\": \"{{keyboardId}}\",\n      \"quantity\": 1\n    },\n    {\n      \"productId\": \"{{mouseId}}\",\n      \"quantity\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (body.orderId) { pm.collectionVariables.set('orderId', body.orderId); }",
                  "pm.test('orderId returned', () => pm.expect(body.orderId).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Order - Replay Same Idempotency-Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": "{{orderingUrl}}/api/orders",
            "description": "Aynı anahtarla tekrar: ikinci sipariş OLUŞMAZ, aynı orderId döner.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerCode\": \"{{customerCode}}\",\n  \"items\": [\n    {\n      \"productId\": \"{{keyboardId}}\",\n      \"quantity\": 1\n    },\n    {\n      \"productId\": \"{{mouseId}}\",\n      \"quantity\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
