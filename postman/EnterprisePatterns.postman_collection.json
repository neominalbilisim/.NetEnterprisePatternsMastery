{
  "info": {
    "name": "Enterprise Patterns Sample (.NET 8)",
    "_postman_id": "8b1f6c4e-3c1a-4a55-9d1e-6f1b2d7a9e01",
    "description": "Ordering + Inventory servisleri için örnek istekler.\n\ngRPC notu: Postman v2.1 collection formatı gRPC isteklerini saklayamaz. Postman'de New > gRPC seçip localhost:5102 adresine bağlanın ve 'Use server reflection' ile inventory.v1.InventoryService/CheckAvailability veya GetProduct metodlarını çağırın. Alternatif: src/Contracts/Contracts.Grpc/Protos/inventory.proto dosyasını içe aktarın.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Inventory (REST)",
      "item": [
        {
          "name": "Get Products (Dapper)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{inventoryUrl}}/api/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Product By Id (Dapper)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{inventoryUrl}}/api/products/{{keyboardId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Product (Idempotent)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{productIdempotencyKey}}"
              }
            ],
            "url": "{{inventoryUrl}}/api/products",
            "description": "Her çalıştırmada yeni bir Idempotency-Key üretilir. SKU benzersiz olduğundan ikinci farklı anahtarlı istek 409 döner.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"HS-001\",\n  \"name\": \"Gaming Headset\",\n  \"unitPrice\": 1499.0,\n  \"initialStock\": 25\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('productIdempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Product - Replay Same Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{productIdempotencyKey}}"
              }
            ],
            "url": "{{inventoryUrl}}/api/products",
            "description": "Aynı Idempotency-Key ile tekrar: yeni ürün oluşturulmaz, ilk yanıttaki productId döner (IdempotencyBehavior).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"HS-001\",\n  \"name\": \"Gaming Headset\",\n  \"unitPrice\": 1499.0,\n  \"initialStock\": 25\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Reservation By Order",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{inventoryUrl}}/api/reservations/by-order/{{orderId}}",
            "description": "OrderCreated event'i sonucu oluşan stok rezervasyonu (Reserved / Rejected)."
          }
        }
      ]
